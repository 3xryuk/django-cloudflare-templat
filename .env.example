DEBUG=True
PYTHONDONTWRITEBYTECODE=1
SECRET_KEY="django-insecure-change-me-in-production"
ALLOWED_HOSTS="localhost,127.0.0.1,*"

# Cloudflare Integration Flags (django-cf)
USE_CLOUDFLARE_WORKER=False
CF_DB_ENGINE="django_cf.db.backends.d1"
CF_D1_BINDING="DB"

# Cloudflare Cache Configuration (r2 | do | kv | db)
CF_DEFAULT_CACHE_BACKEND="r2"
CF_R2_CACHE_BINDING="BUCKET"
CF_R2_CACHE_PREFIX="cache"
CF_DO_CACHE_BINDING="CACHE_DO"
CF_KV_CACHE_BINDING="CACHE_KV"
CF_CACHE_TIMEOUT=300
SESSION_CACHE_ALIAS="do"

# Optional: D1 via HTTP API (for remote D1 access outside a Worker)
USE_CLOUDFLARE_D1_API=False
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_TOKEN=""

# Optional: Cloudflare R2 Storage & Cloudflare Access Middleware
USE_CLOUDFLARE_R2=False
CF_R2_BINDING="BUCKET"
USE_CLOUDFLARE_ACCESS=False

# Management endpoints token (for /__run_migrations__/ and /__create_admin__/)
CF_MANAGEMENT_TOKEN=""
