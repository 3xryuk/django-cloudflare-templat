# Local secrets and development overrides (.dev.vars)
# Non-secret configuration lives in `wrangler.jsonc` under `"vars"`.
# For production, upload secrets with `uv run pywrangler secret put <NAME>`.

DEBUG=True
SECRET_KEY="django-insecure-change-me-in-production"

# Standard Django superuser password.
# Also authorizes serverless `/__run_migrations__/` and `/__create_admin__/`
# via `Authorization: Bearer <DJANGO_SUPERUSER_PASSWORD>`.
DJANGO_SUPERUSER_PASSWORD=""

# Optional: Remote Cloudflare D1 HTTP API credentials (outside Workers runtime)
USE_CLOUDFLARE_D1_API=False
CLOUDFLARE_DATABASE_ID=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_TOKEN=""
